#: src/Application.vala:39
msgid "Create a User"
msgstr "Jimarekî biafirîne"

#: src/Helpers/LocaleHelper.vala:132 src/Views/KeyboardLayoutView.vala:172
#, c-format
msgid "%s…"
msgstr "%s…"

#: src/Objects/KeyboardVariant.vala:27
msgid "Default"
msgstr "Berdest"

#: src/Views/AccountView.vala:58
msgid "Create an Account"
msgstr "Jimarekî biafirîne"

#: src/Views/AccountView.vala:69
msgid "Full Name"
msgstr "Nav û paşnav"

#: src/Views/AccountView.vala:75
msgid "Username"
msgstr "Navê bikarhêner"

#: src/Views/AccountView.vala:90
msgid "Choose a Password"
msgstr "Borînpeyvekê hilbijêre"

#: src/Views/AccountView.vala:109
msgid "Confirm Password"
msgstr "Borînpeyvê piştrast bike"

#: src/Views/AccountView.vala:122
msgid "Device name"
msgstr "Navê amûrê"

#: src/Views/AccountView.vala:125
msgid ""
"Visible to other devices when sharing, e.g. with Bluetooth or over the "
"network."
msgstr ""
"Di dema parvekirinê ji amûrên din de xuya dibe, b.m. bi riya Bluetooth an "
"torê."

#: src/Views/AccountView.vala:135
#, c-format
msgid "Unable to setup Hostname interface: %s"
msgstr "Sazkirina navrûya navê mêvandar têk çû: %s"

#: src/Views/AccountView.vala:166 src/Views/KeyboardLayoutView.vala:40
#: src/Views/NetworkView.vala:68
msgid "Back"
msgstr "Vegere"

#: src/Views/AccountView.vala:170
msgid "Finish Setup"
msgstr "Sazkirinê biqedîne"

#: src/Views/AccountView.vala:235
msgid "Acceptable password"
msgstr "Borînpeyv guncav e"

#: src/Views/AccountView.vala:237
msgid "Good password"
msgstr "Borînpeyv baş e"

#: src/Views/AccountView.vala:239
msgid "Great password"
msgstr "Borînpeyv gelekî baş e"

#: src/Views/AccountView.vala:260
msgid "Passwords do not match"
msgstr "Borînpeyv ne wek hev in"

#: src/Views/AccountView.vala:266
msgid "Passwords match"
msgstr "Borînpeyv wek hev in"

#: src/Views/AccountView.vala:301
msgid "The chosen username is already taken"
msgstr "Navê bikarhêner ê hilbijartî berê hatiye standin"

#: src/Views/AccountView.vala:303
msgid ""
"A username must only contain lowercase letters, numbers, hyphens, and "
"underscores, without spaces"
msgstr ""
"Divê di navê bikarhêner de tenê tîpên hûrik, jimar, xêzik û binerxêzik hebin "
"û bê valahî be"

#: src/Views/AccountView.vala:368
#, c-format
msgid "Creating an account for “%s” failed"
msgstr "Afirandina jimarekî ji bo \"%s\" têk çû"

#: src/Views/AccountView.vala:375
#, c-format
msgid "Couldn't get permission to create an account for “%s”"
msgstr "Mafdayîn ji bo afirandina jimarekî ji bo \"%s\" têk çû"

#: src/Views/AccountView.vala:390
#, c-format
msgid "Couldn't get permission to name this device “%s”"
msgstr "Mafdayîn ji bo navkirina vê amûrê bi \"%s\" têk çû"

#: src/Views/AccountView.vala:394
#, c-format
msgid "Unable to name this device “%s”"
msgstr "Navkirina vê amûrê bi \"%s\" têk çû"

#: src/Views/AccountView.vala:445
msgid "Initial Setup could not set your hostname."
msgstr "Sazkirina destpêkê nekarî navê te yê mêvandar saz bike."

#: src/Views/AccountView.vala:464
msgid ""
"Initial Setup could not create this account. Without it, you will not be "
"able to log in and may need to reinstall the OS."
msgstr ""
"Sazkirina destpêkê nekarî vê jimarê biafirîne. Bê wê tu yê nikaribî têkevî û "
"dibe ku pêwîst bike tu pergala xebatê ji nû ve saz bikî."

#: src/Views/KeyboardLayoutView.vala:15
msgid "Select Keyboard Layout"
msgstr "Şêwaza kilîtdankê hilbijêre"

#: src/Views/KeyboardLayoutView.vala:19
msgid "Input Language"
msgstr "Zimanê ketanê"

#: src/Views/KeyboardLayoutView.vala:25
msgid "Type to test your layout"
msgstr "Binivîse da ku şêwaza kilîtdanka xwe test bikî"

#: src/Views/KeyboardLayoutView.vala:28
msgid "Show keyboard layout"
msgstr "Şêwaza kilîtdankê nîşan bide"

#: src/Views/KeyboardLayoutView.vala:44 src/Views/LanguageView.vala:104
#: src/Views/LanguageView.vala:179
msgid "Select"
msgstr "Hilbijêre"

#: src/Views/LanguageView.vala:67
msgid "Languages"
msgstr "Ziman"

#: src/Views/LanguageView.vala:246
msgid "Use the right mouse button for primary click?"
msgstr "Bişkoka rastê ya mişkê ji bo tikandina bingehîn bi kar bîne?"

#: src/Views/LanguageView.vala:247
msgid ""
"The right mouse button was used where a primary click was expected. You can "
"choose to always use the right mouse button for primary click."
msgstr ""
"Bişkoka rastê ya mişkê hate bikaranîn li cihê ku tikandina bingehîn dihate "
"bendêkirin. Tu dikarî hilbijêrî ku her dem ji bo tikandina bingehîn bişkoka "
"rastê ya mişkê bi kar bînî."

#: src/Views/LanguageView.vala:248 src/Views/LanguageView.vala:255
msgid "Right-Click as Primary"
msgstr "Tikandina rastê wekî bingehîn"

#: src/Views/LanguageView.vala:249 src/Views/LanguageView.vala:254
msgid "Left-Click as Primary"
msgstr "Tikandina çepê wekî bingehîn"

#: src/Views/LanguageView.vala:252
msgid "Use the left mouse button for primary click?"
msgstr "Bişkoka çepê ya mişkê ji bo tikandina bingehîn bi kar bîne?"

#: src/Views/LanguageView.vala:253
msgid ""
"The left mouse button was used where a primary click was expected. You can "
"choose to always use the left mouse button for primary click."
msgstr ""
"Bişkoka çepê ya mişkê hate bikaranîn li cihê ku tikandina bingehîn dihate "
"bendêkirin. Tu dikarî hilbijêrî ku her dem ji bo tikandina bingehîn bişkoka "
"çepê ya mişkê bi kar bînî."

#: src/Views/LanguageView.vala:323
msgid "Select a Language"
msgstr "Zimanekî hilbijêre"

#: src/Views/LanguageView.vala:348 src/Views/LanguageView.vala:408
msgid "Currently active language"
msgstr "Zimanê niha çalak"

#: src/Views/NetworkView.vala:30
msgid "Connect Network"
msgstr "Torê girê bide"

#: src/Views/NetworkView.vala:34
msgid ""
"An Internet connection is required to receive updates, install new apps, and "
"connect to online services"
msgstr ""
"Girêdaneke înternetê pêwîst e ji bo wergirtina rojanekirinan, sazkirina "
"sepanên nû û girêdana bi rajekarên serhêl re"

#. /Translators: for RTL languages, the UI is flipped
#: src/Views/NetworkView.vala:44
msgid ""
"Choose a nearby wireless network from the network indicator in the top right."
msgstr "Toreke bêtêl a nêzîk ji nîşaneya torê ya li jor rastê hilbijêre."

#: src/Views/NetworkView.vala:50
msgid "Connect a network cable"
msgstr "Kebleke torê girê bide"

#: src/Views/NetworkView.vala:72
msgid "Skip"
msgstr "Derbas bike"

#: src/Views/NetworkView.vala:88
msgid "Next"
msgstr "Pêş"

